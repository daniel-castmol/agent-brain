# brain — environment variables.
#
# Copy this file to .env to override defaults. All settings are optional;
# the defaults below are what brain uses if you don't set anything.
#
# cp .env.example .env

# Where the markdown vault lives.
# All notes go here, organized however you like.
# BRAIN_VAULT_DIR=~/brain-vault

# Where the DuckDB index file lives. This is fully rebuildable from the vault
# via `brain index`, so it can be wiped any time.
# BRAIN_DB_DIR=~/.brain
# BRAIN_DB_FILENAME=db.duckdb

# Embedding model. Default is bge-small-en-v1.5 (English-only, 384d, ~30MB).
# If you change this, you MUST also change BRAIN_EMBEDDING_DIM to match the
# model's output dimensionality, and you'll need to re-index from scratch
# (the DuckDB column type is fixed at table-creation time).
#
# Multilingual alternative: BAAI/bge-m3 (1024d, larger, slower).
# Changing the model (or the prefixes below) invalidates stored vectors:
# run `brain index --rebuild` afterwards.
# BRAIN_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# BRAIN_EMBEDDING_DIM=384

# Asymmetric embedding prefixes, applied at embed time only (never stored).
# e5-family models need these; bge models do not.
# BRAIN_QUERY_PREFIX="query: "
# BRAIN_PASSAGE_PREFIX="passage: "

# Stemmer for the DuckDB full-text index. 'porter' (English) is the default;
# use 'spanish' for a Spanish vault or 'none' for mixed-language vaults.
# Changing it takes effect on the next search (the FTS index is rebuilt).
# BRAIN_FTS_STEMMER=porter

# Chunking. Section-aware splits target this character count, with overlap
# between split chunks for context preservation across boundaries.
# BRAIN_CHUNK_TARGET_CHARS=1500
# BRAIN_CHUNK_OVERLAP_CHARS=150

# Reciprocal rank fusion constant for hybrid retrieval. Higher values give
# more weight to the long tail; lower values emphasize the top of each list.
# 60 is the standard from the RRF paper.
# BRAIN_RRF_K=60
